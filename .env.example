# ─── WooCommerce REST API ─────────────────────────────────────────────────────
# Your WooCommerce store URL (no trailing slash)
WC_STORE_URL=https://your-store.com

# Create keys at: WooCommerce → Settings → Advanced → REST API
# Permission required: Read
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: shown in Settings UI
NEXT_PUBLIC_WC_STORE_URL=https://your-store.com
